<%
const list = comments || [];
const latestCommentId = typeof newCommentId === 'number' ? newCommentId : null;
const canManageComments = eventStatus !== 'cancelled';

function timeAgo(date) {
  const seconds = Math.floor((Date.now() - new Date(date).getTime()) / 1000);
  if (seconds < 60)   return seconds + 's ago';
  if (seconds < 3600) return Math.floor(seconds / 60) + 'm ago';
  if (seconds < 86400) return Math.floor(seconds / 3600) + 'h ago';
  return Math.floor(seconds / 86400) + 'd ago';
}
%>

<div
  id="comments-list"
  class="space-y-3 sm:space-y-4"
  x-data="{
    sortOrder: 'oldest',
    sortComments() {
      const container = this.$refs.commentItems;
      if (!container) return;
      const items = Array.from(container.children);
      items.sort((a, b) => {
        const aTime = Number(a.dataset.createdAt || 0);
        const bTime = Number(b.dataset.createdAt || 0);
        return this.sortOrder === 'newest' ? bTime - aTime : aTime - bTime;
      });
      items.forEach(item => container.appendChild(item));
    }
  }"
  x-init="$nextTick(() => sortComments())"
>
  <div class="flex flex-col gap-3 border-b border-blue-300/10 pb-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-medium text-blue-100/80">
        <span class="text-white"><%= list.length %></span>
        <%= list.length === 1 ? 'comment' : 'comments' %>
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-[0.25em] text-blue-100/55">Sort</span>
      <div class="inline-flex rounded-2xl border border-blue-300/15 bg-slate-950/50 p-1">
        <button
          type="button"
          x-on:click="sortOrder = 'oldest'; sortComments()"
          :class="sortOrder === 'oldest' ? 'bg-blue-400 text-slate-950' : 'text-blue-100/75 hover:bg-blue-400/10 hover:text-white'"
          class="inline-flex cursor-pointer items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold transition"
        >
          Oldest
        </button>
        <button
          type="button"
          x-on:click="sortOrder = 'newest'; sortComments()"
          :class="sortOrder === 'newest' ? 'bg-blue-400 text-slate-950' : 'text-blue-100/75 hover:bg-blue-400/10 hover:text-white'"
          class="inline-flex cursor-pointer items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold transition"
        >
          Newest
        </button>
      </div>
    </div>
  </div>

  <% if (list.length === 0) { %>
    <div class="rounded-2xl border border-dashed border-blue-300/20 bg-slate-950/30 px-4 py-6 text-center sm:px-6">
      <p class="text-sm text-blue-100/70 sm:text-base">No comments yet. Be the first to start the conversation.</p>
    </div>
  <% } %>

  <div x-ref="commentItems" class="space-y-3 sm:space-y-4">
    <% list.forEach(comment => { %>
      <%- include('comment', { comment, user, timeAgo, animate: comment.id === latestCommentId, canManageComments }) %>
    <% }) %>
  </div>
</div>
