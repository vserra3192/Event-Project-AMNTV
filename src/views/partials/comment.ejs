<div
  class="comment rounded-2xl border border-blue-300/12 bg-slate-950/35 p-4 shadow-[0_18px_40px_-30px_rgba(59,130,246,0.8)] transition sm:p-5"
  id="comment-<%= comment.id %>"
  x-data="{ confirmDelete: false }"
  <% if (animate) { %>x-init="$el.classList.add('ring-2','ring-blue-400/50','bg-blue-400/10'); setTimeout(() => $el.classList.remove('ring-2','ring-blue-400/50','bg-blue-400/10'), 1800)"<% } %>
>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-blue-100/70">
        <strong class="text-white"><%= comment.displayName || "Unknown User" %></strong>
        <span class="hidden sm:inline text-blue-200/35">•</span>
        <span><%= timeAgo(comment.createdAt) %></span>
      </div>
      <p class="mt-2 whitespace-pre-wrap break-words text-sm leading-6 text-blue-100/90 sm:text-base"><%= comment.content %></p>
    </div>

    <% const canDelete =
      user &&
      (
        user.role === "admin" ||
        user.userId === comment.userId ||
        user.userId === organizerId
      );
  %>

    <% if (canDelete) { %>
      <div class="flex items-center gap-2 self-start sm:self-center">
        <button
          type="button"
          class="cursor-pointer rounded-full border border-red-400/30 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-red-200 transition hover:bg-red-500/10"
          x-show="!confirmDelete"
          x-on:click="confirmDelete = true"
        >
          Delete
        </button>
        <div class="flex items-center gap-2" x-cloak x-show="confirmDelete">
          <span class="text-xs text-blue-100/60">Delete comment?</span>
          <button
            type="button"
            class="cursor-pointer rounded-full border border-blue-300/25 px-3 py-1 text-xs font-medium text-blue-100/80 transition hover:bg-blue-400/10"
            x-on:click="confirmDelete = false"
          >
            Cancel
          </button>
          <button
            type="button"
            class="cursor-pointer rounded-full bg-red-500 px-3 py-1 text-xs font-semibold text-white transition hover:bg-red-400"
            hx-post="/comments/<%= comment.id %>/delete?eventId=<%= comment.eventId %>"
            hx-target="#comments"
            hx-swap="innerHTML"
          >
            Confirm
          </button>
        </div>
      </div>
    <% } %>
  </div>
</div>
