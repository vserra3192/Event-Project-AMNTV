<div
  class="comment border-b py-2 transition duration-300 ease-out"
  id="comment-<%= comment.id %>"
  x-data="{ entered: <%= animate ? 'false' : 'true' %> }"
  x-init="if (!entered) requestAnimationFrame(() => { entered = true; })"
  :class="entered ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-2'"
>

  <div class="flex justify-between items-center text-sm text-gray-600">
    <div>
      <strong><%= comment.displayName %></strong>
      ·
      <span><%= timeAgo(comment.createdAt) %></span>
    </div>

      <% const canDelete =
      user &&
      (
        user.role === "admin" ||
        user.userId === comment.userId ||
        user.userId === organizerId
      );
  %>

  <% if (canDelete) { %>
    <button
      class="text-red-500 hover:underline text-xs cursor-pointer"
      hx-post="/comments/<%= comment.id %>/delete?eventId=<%= comment.eventId %>"
      hx-target="#comments"
      hx-swap="innerHTML"
    >
      Delete
    </button>
  <% } %>
  </div>

  <div class="mt-1 text-gray-800">
    <%= comment.content %>
  </div>

</div>
