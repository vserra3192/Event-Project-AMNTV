<div class="comment border-b border-blue-300/10 py-3" id="comment-<%= comment.id %>">

  <div class="flex justify-between items-center text-sm text-blue-100/70">
    <div>
      <strong><%= comment.displayName %></strong>
      ·
      <span><%= timeAgo(comment.createdAt) %></span>
    </div>

      <% const canDelete =
      user &&
      (
        user.role === "admin" ||
        user.userId === comment.userId ||
        user.userId === organizerId
      );
  %>

  <% if (canDelete) { %>
    <button
      class="text-red-500 hover:underline text-xs cursor-pointer"
      hx-post="/comments/<%= comment.id %>/delete?eventId=<%= comment.eventId %>"
      hx-target="#comments"
      hx-swap="innerHTML"
    >
      Delete
    </button>
  <% } %>
  </div>

  <div class="mt-1 text-blue-100/90">
    <%= comment.content %>
  </div>

</div>
