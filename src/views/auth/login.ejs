<section
  class="mb-6 rounded-3xl border border-blue-300/15 bg-slate-900/60 px-7 py-6 shadow-[0_25px_60px_-35px_rgba(15,105,255,0.45)] backdrop-blur-lg"
>
  <h1 class="text-3xl font-semibold text-white mb-2">Sign In</h1>
  <p class="text-sm text-blue-100/70">
    Log in with one of the demo accounts below to start exploring the event tracker.
  </p>
</section>

<% if (pageError) { %>
  <%- include("partials/error", { message: pageError }) %>
<% } %>

<section
  class="max-w-3xl rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl"
>
  <div class="mb-6">
    <h2 class="text-2xl font-semibold text-white mb-2">Log In</h2>
    <p class="text-sm text-blue-100/70">
      This starter ships with three demo users so you can focus on shipping features.
    </p>
  </div>

  <form class="grid gap-4" method="post" action="/login">
    <label for="email" class="text-xs font-semibold uppercase tracking-wider text-blue-200"
      >Email</label
    >
    <input
      id="email"
      name="email"
      type="email"
      autocomplete="username"
      required
      class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
    />

    <label for="password" class="text-xs font-semibold uppercase tracking-wider text-blue-200"
      >Password</label
    >
    <input
      id="password"
      name="password"
      type="password"
      autocomplete="current-password"
      required
      class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
    />

    <button
      type="submit"
      class="mt-2 inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-5 py-3 text-sm font-semibold uppercase tracking-wide text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80"
    >
      Log in
    </button>
  </form>

  <div class="mt-7 rounded-2xl border border-blue-300/10 bg-slate-950/40 px-5 py-5">
    <h3 class="text-base font-semibold text-white mb-3">Demo Users</h3>
    <ul class="space-y-2 text-sm text-blue-100/80">
      <li>
        <code class="rounded bg-slate-800/70 px-2 py-1 text-blue-200">admin@app.test</code>
        /
        <code class="rounded bg-slate-800/70 px-2 py-1 text-blue-200">password123</code>
        /
        <code class="rounded bg-slate-800/70 px-2 py-1 text-blue-200">Admin</code>
      </li>
      <li>
        <code class="rounded bg-slate-800/70 px-2 py-1 text-blue-200">staff@app.test</code>
        /
        <code class="rounded bg-slate-800/70 px-2 py-1 text-blue-200">password123</code>
        /
        <code class="rounded bg-slate-800/70 px-2 py-1 text-blue-200">Staff</code>
      </li>
      <li>
        <code class="rounded bg-slate-800/70 px-2 py-1 text-blue-200">user@app.test</code>
        /
        <code class="rounded bg-slate-800/70 px-2 py-1 text-blue-200">password123</code>
        /
        <code class="rounded bg-slate-800/70 px-2 py-1 text-blue-200">User</code>
      </li>
    </ul>
  </div>
</section>