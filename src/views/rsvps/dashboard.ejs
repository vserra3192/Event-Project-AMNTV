<section class="mb-5 p-6 border rounded-2xl bg-white shadow">
  <h1 class="text-3xl font-bold">My RSVPs</h1>

  <% if (session.authenticatedUser) { %>
    <p class="text-slate-500 mt-2">
      Signed in as <strong><%= session.authenticatedUser.displayName %></strong>
    </p>
  <% } %>
</section>

<!-- UPCOMING -->
<section class="mb-8">
  <h2 class="text-xl font-semibold mb-3">Upcoming Events</h2>

  <% if (!upcoming.length) { %>
    <p class="text-slate-500">No upcoming RSVPs.</p>
  <% } %>

  <% upcoming.forEach(item => { %>
    <div class="p-4 border rounded-xl bg-green-50 mb-2">
      <div class="flex justify-between">
        <div>
          <p class="font-semibold"><%= item.event.title %></p>
          <p class="text-sm text-slate-500">
            Status: <%= item.rsvp.status %>
          </p>
          <p class="text-xs text-slate-400">
            <%= new Date(item.event.startDatetime).toLocaleString() %>
          </p>
        </div>
      </div>
    </div>
  <% }) %>
</section>

<!-- PAST -->
<section>
  <h2 class="text-xl font-semibold mb-3">Past / Cancelled</h2>

  <% if (!past.length) { %>
    <p class="text-slate-500">No past RSVPs.</p>
  <% } %>

  <% past.forEach(item => { %>
    <div class="p-3 border rounded-xl bg-slate-50 opacity-70 mb-2">
      <p class="font-medium"><%= item.event.title %></p>
      <p class="text-sm text-slate-500">
        <%= item.rsvp.status %>
      </p>
    </div>
  <% }) %>
</section>