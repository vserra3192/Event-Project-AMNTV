<section
  id="friends-panel"
  class="min-h-0 flex-1 overflow-y-auto p-6"
  aria-live="polite"
  x-data="{ tab: 'add', query: '<%= view.query.replace(/'/g, '&#39;') %>' }"
>
  <div class="mb-5 grid grid-cols-2 rounded-2xl border border-blue-300/15 bg-slate-950/50 p-1">
    <button
      type="button"
      x-on:click="tab = 'add'"
      class="rounded-xl px-4 py-2 text-sm font-semibold transition"
      x-bind:class="tab === 'add' ? 'bg-blue-500/30 text-white' : 'text-blue-100/70 hover:bg-blue-400/15 hover:text-white'"
    >
      Add Friends
    </button>
    <button
      type="button"
      x-on:click="tab = 'mine'"
      class="rounded-xl px-4 py-2 text-sm font-semibold transition"
      x-bind:class="tab === 'mine' ? 'bg-blue-500/30 text-white' : 'text-blue-100/70 hover:bg-blue-400/15 hover:text-white'"
    >
      My Friends
    </button>
  </div>

  <% if (view.notice) { %>
    <div class="mb-4 rounded-2xl border border-emerald-300/25 bg-emerald-950/40 px-5 py-4 text-sm text-emerald-100">
      <%= view.notice %>
    </div>
  <% } %>

  <% if (view.pageError) { %>
    <div class="mb-4">
      <%- include("../../partials/error", { message: view.pageError }) %>
    </div>
  <% } %>

  <div x-show="tab === 'add'" class="space-y-5">
    <form class="relative">
      <label for="friend-panel-search" class="sr-only">Search members</label>
      <input
        id="friend-panel-search"
        x-model="query"
        type="text"
        name="q"
        placeholder="Search members..."
        value="<%= view.query %>"
        hx-get="/friends/search?panel=true"
        hx-trigger="input changed delay:400ms"
        hx-target="#friends-panel"
        hx-swap="outerHTML"
        class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-5 py-4 pr-16 text-base text-white shadow-inner shadow-slate-900 transition focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
      />
      <button
        type="button"
        x-show="query.length > 0"
        x-on:click.prevent="query = ''; const input = document.getElementById('friend-panel-search'); input.value = ''; input.dispatchEvent(new Event('input', { bubbles: true }))"
        class="absolute right-2 top-1/2 inline-flex h-9 -translate-y-1/2 items-center justify-center rounded-full bg-slate-800/80 px-3 text-sm text-blue-100/80 transition hover:bg-blue-400/20 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Clear
      </button>
    </form>

    <% if (view.query.trim().length >= 2) { %>
      <% if (view.searchResults.length > 0) { %>
        <ul class="grid gap-3">
          <% view.searchResults.forEach((user) => { %>
            <li class="flex flex-col gap-3 rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="mb-1 text-base font-semibold text-white"><%= user.displayName %></p>
                <p class="mb-0 text-sm text-blue-100/65"><%= user.email %></p>
              </div>
              <form hx-post="/friends/requests?panel=true" hx-target="#friends-panel" hx-swap="outerHTML" class="m-0">
                <input type="hidden" name="userId" value="<%= user.id %>" />
                <button type="submit" class="inline-flex w-full items-center justify-center rounded-xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-blue-900/50 transition hover:-translate-y-0.5 hover:shadow-blue-900/70 sm:w-auto">
                  Add Friend
                </button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="rounded-2xl border border-blue-300/10 bg-slate-950/40 px-4 py-5 text-center text-blue-100/70">
          No available members match "<%= view.query %>".
        </p>
      <% } %>
    <% } else { %>
      <p class="rounded-2xl border border-blue-300/10 bg-slate-950/40 px-4 py-5 text-center text-blue-100/70">
        Type at least two characters to search members.
      </p>
    <% } %>
  </div>

  <div x-show="tab === 'mine'" x-cloak class="space-y-5">
    <section>
      <div class="mb-3 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-white">Friends List</h3>
        <span class="text-sm text-blue-100/60"><%= view.friends.length %> friend<%= view.friends.length === 1 ? "" : "s" %></span>
      </div>
      <% if (view.friends.length > 0) { %>
        <ul class="grid gap-3">
          <% view.friends.forEach((user) => { %>
            <li class="flex flex-col gap-3 rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="mb-1 font-semibold text-white"><%= user.displayName %></p>
                <p class="mb-0 text-sm text-blue-100/65"><%= user.email %></p>
              </div>
              <form hx-post="/friends/<%= user.id %>/remove?panel=true" hx-target="#friends-panel" hx-swap="outerHTML" class="m-0">
                <button type="submit" class="inline-flex w-full items-center justify-center rounded-xl border border-red-300/25 bg-red-950/40 px-4 py-2 text-sm font-semibold text-red-100 transition hover:bg-red-500/20 hover:text-white sm:w-auto">
                  Remove
                </button>
              </form>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="rounded-2xl border border-blue-300/10 bg-slate-950/40 px-4 py-6 text-center text-blue-100/70">
          Your friends list is empty.
        </p>
      <% } %>
    </section>
  </div>
</section>
