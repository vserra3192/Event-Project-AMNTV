<section
  id="friends-workspace"
  class="space-y-6"
  aria-live="polite"
  x-data="{ query: '<%= view.query.replace(/'/g, '&#39;') %>' }"
>
  <% if (view.notice) { %>
    <div class="rounded-2xl border border-emerald-300/25 bg-emerald-950/40 px-5 py-4 text-sm text-emerald-100">
      <%= view.notice %>
    </div>
  <% } %>

  <% if (view.pageError) { %>
    <%- include("../../partials/error", { message: view.pageError }) %>
  <% } %>

  <section class="rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
    <div class="mb-5">
      <h2 class="text-xl font-semibold text-white mb-2">Find Members</h2>
      <p class="text-blue-100/70 mb-0">Search by name or email to send a friend request.</p>
    </div>

    <form class="relative">
      <label for="friend-search-query" class="sr-only">Search members</label>
      <input
        id="friend-search-query"
        x-model="query"
        type="text"
        name="q"
        placeholder="Search members..."
        value="<%= view.query %>"
        hx-get="/friends/search"
        hx-trigger="input changed delay:400ms"
        hx-target="#friends-workspace"
        hx-swap="outerHTML"
        class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-5 py-4 pr-16 text-base text-white shadow-inner shadow-slate-900 transition focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
      />
      <button
        type="button"
        x-show="query.length > 0"
        x-on:click.prevent="query = ''; const input = document.getElementById('friend-search-query'); input.value = ''; input.dispatchEvent(new Event('input', { bubbles: true }))"
        class="absolute right-2 top-1/2 inline-flex h-9 -translate-y-1/2 items-center justify-center rounded-full bg-slate-800/80 px-3 text-sm text-blue-100/80 transition hover:bg-blue-400/20 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Clear
      </button>
    </form>

    <% if (view.query.trim().length >= 2) { %>
      <div class="mt-5">
        <% if (view.searchResults.length > 0) { %>
          <ul class="grid gap-3">
            <% view.searchResults.forEach((user) => { %>
              <li class="flex flex-col gap-3 rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 sm:flex-row sm:items-center sm:justify-between">
                <div>
                  <p class="mb-1 text-base font-semibold text-white"><%= user.displayName %></p>
                  <p class="mb-0 text-sm text-blue-100/65"><%= user.email %></p>
                </div>
                <form
                  hx-post="/friends/requests"
                  hx-target="#friends-workspace"
                  hx-swap="outerHTML"
                  class="m-0"
                >
                  <input type="hidden" name="userId" value="<%= user.id %>" />
                  <button
                    type="submit"
                    class="inline-flex w-full items-center justify-center rounded-xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-blue-900/50 transition hover:-translate-y-0.5 hover:shadow-blue-900/70 sm:w-auto"
                  >
                    Add Friend
                  </button>
                </form>
              </li>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="rounded-2xl border border-blue-300/10 bg-slate-950/40 px-4 py-5 text-center text-blue-100/70">
            No available members match "<%= view.query %>".
          </p>
        <% } %>
      </div>
    <% } %>
  </section>

  <div class="grid gap-6 lg:grid-cols-2">
    <section class="rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
      <div class="mb-5 flex items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-semibold text-white mb-2">Incoming Requests</h2>
          <p class="text-blue-100/70 mb-0"><%= view.incomingRequests.length %> waiting</p>
        </div>
      </div>

      <% if (view.incomingRequests.length > 0) { %>
        <ul class="grid gap-3">
          <% view.incomingRequests.forEach((user) => { %>
            <li class="rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4">
              <div class="mb-3">
                <p class="mb-1 font-semibold text-white"><%= user.displayName %></p>
                <p class="mb-0 text-sm text-blue-100/65"><%= user.email %></p>
              </div>
              <div class="flex flex-wrap gap-2">
                <form hx-post="/friends/requests/<%= user.id %>/accept" hx-target="#friends-workspace" hx-swap="outerHTML" class="m-0">
                  <button type="submit" class="rounded-xl bg-emerald-500/90 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-400">
                    Accept
                  </button>
                </form>
                <form hx-post="/friends/requests/<%= user.id %>/decline" hx-target="#friends-workspace" hx-swap="outerHTML" class="m-0">
                  <button type="submit" class="rounded-xl border border-blue-300/20 bg-slate-800/80 px-4 py-2 text-sm font-semibold text-blue-100 transition hover:bg-blue-400/20 hover:text-white">
                    Decline
                  </button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="rounded-2xl border border-blue-300/10 bg-slate-950/40 px-4 py-5 text-center text-blue-100/70">
          No incoming friend requests.
        </p>
      <% } %>
    </section>

    <section class="rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
      <div class="mb-5">
        <h2 class="text-xl font-semibold text-white mb-2">Outgoing Requests</h2>
        <p class="text-blue-100/70 mb-0"><%= view.outgoingRequests.length %> pending</p>
      </div>

      <% if (view.outgoingRequests.length > 0) { %>
        <ul class="grid gap-3">
          <% view.outgoingRequests.forEach((user) => { %>
            <li class="rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4">
              <p class="mb-1 font-semibold text-white"><%= user.displayName %></p>
              <p class="mb-0 text-sm text-blue-100/65"><%= user.email %></p>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p class="rounded-2xl border border-blue-300/10 bg-slate-950/40 px-4 py-5 text-center text-blue-100/70">
          No pending outgoing requests.
        </p>
      <% } %>
    </section>
  </div>

  <section class="rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
    <div class="mb-5">
      <h2 class="text-xl font-semibold text-white mb-2">Friends List</h2>
      <p class="text-blue-100/70 mb-0"><%= view.friends.length %> friend<%= view.friends.length === 1 ? "" : "s" %></p>
    </div>

    <% if (view.friends.length > 0) { %>
      <ul class="grid gap-3 md:grid-cols-2">
        <% view.friends.forEach((user) => { %>
          <li class="flex flex-col gap-3 rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="mb-1 font-semibold text-white"><%= user.displayName %></p>
              <p class="mb-0 text-sm text-blue-100/65"><%= user.email %></p>
            </div>
            <form hx-post="/friends/<%= user.id %>/remove" hx-target="#friends-workspace" hx-swap="outerHTML" class="m-0">
              <button
                type="submit"
                class="inline-flex w-full items-center justify-center rounded-xl border border-red-300/25 bg-red-950/40 px-4 py-2 text-sm font-semibold text-red-100 transition hover:bg-red-500/20 hover:text-white sm:w-auto"
              >
                Remove
              </button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="rounded-2xl border border-blue-300/10 bg-slate-950/40 px-4 py-6 text-center text-blue-100/70">
        Your friends list is empty.
      </p>
    <% } %>
  </section>
</section>
