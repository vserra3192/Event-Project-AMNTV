<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-3">Dashboard</h1>
  <p class="text-slate-500">
    Manage your upcoming events.
  </p>
  <% if (session.authenticatedUser) { %>
    <p class="text-slate-500 mt-2 mb-0">
      Signed in as <strong class="text-slate-700"><%= session.authenticatedUser.displayName %></strong>
      (<%= session.authenticatedUser.role %>).
    </p>
    <div class="mt-4 flex flex-wrap gap-3">
      <a
        href="/events/rsvp"
        class="inline-flex items-center gap-2 px-4 py-2 bg-slate-100 text-slate-700 rounded-lg hover:bg-slate-200"
      >
        View My RSVPs
      </a>
      <a
        href="/events/new"
        class="inline-flex items-center gap-2 px-4 py-2 bg-white text-slate-700 rounded-lg border border-slate-200 hover:bg-slate-50"
      >
        Create Event
      </a>
    </div>
  <% } %>
</section>

<%- include('./dashboard/partials/dashboard-events-list-page', { data, session, isArchive: false }) %>
