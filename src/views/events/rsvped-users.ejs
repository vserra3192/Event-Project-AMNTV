<div class="space-y-4">
  <% if (pageError) { %>
    <div class="rounded-lg bg-red-950/50 border border-red-400/30 p-4 text-red-100">
      <%= pageError %>
    </div>
  <% } %>

  <% if (data && data.length > 0) { %>
    <div class="space-y-3">
      <% data.forEach((attendee) => { %>
        <div class="flex items-center justify-between gap-4 rounded-xl border border-blue-300/10 bg-slate-950/40 p-4">
          <div>
            <p class="text-white font-medium"><%= attendee.displayName %></p>
            <p class="text-blue-100/70 text-sm">User ID: <%= attendee.id %></p>
          </div>
          <button
            hx-post="/events/<%= eventId %>/rsvped-users/<%= attendee.id %>/remove"
            hx-target="#rsvp-list"
            hx-swap="innerHTML"
            class="px-4 py-2 rounded-lg bg-red-500/90 text-white shadow-lg shadow-red-950/40 hover:bg-red-500"
          >
            Remove
          </button>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="rounded-xl border border-blue-300/10 bg-slate-950/40 p-6 text-center">
      <p class="text-blue-100/80">No attendees have RSVP'd for this event yet.</p>
    </div>
  <% } %>
</div>
