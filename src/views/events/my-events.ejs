<section class="mb-6 rounded-3xl border border-blue-300/15 bg-slate-900/60 px-7 py-6 shadow-[0_25px_60px_-35px_rgba(15,105,255,0.45)] backdrop-blur-lg">
  <h1 class="text-3xl font-semibold text-white mb-3">My Events</h1>
  <p class="text-blue-100/70">
    View and manage all your events.
  </p>
  <% if (session.authenticatedUser) { %>
    <p class="text-blue-100/70 mt-2 mb-0">
      Signed in as <strong class="text-blue-100/80"><%= session.authenticatedUser.displayName %></strong>
      (<%= session.authenticatedUser.role %>).
    </p>
  <% } %>
</section>


<section class="rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
  <div class="mb-4 flex justify-between items-center">
    <div>
      <h2 class="text-xl font-semibold text-white mb-2">Your Events</h2>
      <p class="text-blue-100/70">
        <% if (data && data.length > 0) { %>
          Displaying <%= data.length %> event<%= data.length === 1 ? '' : 's' %>.
        <% } else { %>
          No events found.
        <% } %>
      </p>
    </div>
    <a
      href="/events/new"
      class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 focus:outline-none focus:ring-2 focus:ring-blue-500"
    >
      Create New Event
    </a>
  </div>

  <% if (data && data.length > 0) { %>
    <ul class="list-none m-0 p-0 grid gap-3.5">
      <% data.forEach((event) => { %>
        <li class="flex flex-col gap-3 rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4">
          <div class="flex items-start justify-between gap-4">
            <div>
              <strong class="text-white text-lg"><%= event.title %></strong>
              <p class="text-sm text-blue-100/70 mt-1 mb-0">
                Category: <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-400/15 text-blue-100">
                  <%= event.category %>
                </span>
              </p>
            </div>
            <div class="text-right">
              <%- include("../partials/status-badge", { status: event.status, eventId: event.id }) %>
            </div>
          </div>
          <div class="grid grid-cols-2 gap-3 text-sm">
            <div>
              <p class="text-blue-100/70 mb-0.5">Start</p>
              <p class="text-white font-medium">
                <%= new Date(event.startDatetime).toLocaleString() %>
              </p>
            </div>
            <div>
              <p class="text-blue-100/70 mb-0.5">End</p>
              <p class="text-white font-medium">
                <%= new Date(event.endDatetime).toLocaleString() %>
              </p>
            </div>
          </div>
          <div class="flex gap-2 mt-2">
            <a
              href="/events/<%= event.id %>"
              class="px-3 py-1 bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 text-sm rounded hover:shadow-blue-900/80"
            >
              View
            </a>
            <a
              href="/Event/<%= event.id %>/Edit"
              class="px-3 py-1 bg-slate-800/80 text-blue-100 border border-blue-300/20 text-sm rounded hover:bg-blue-400/20 hover:text-white"
            >
              Edit
            </a>
          </div>
        </li>
      <% }) %>
    </ul>
  <% } else { %>
    <div class="text-center py-8">
      <p class="text-blue-100/70 mb-4">No events available at this time.</p>
      <a
        href="/events/new"
        class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-5 py-3 text-sm font-semibold uppercase tracking-wide text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Create Your First Event
      </a>
    </div>
  <% } %>
</section>