<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-3">Search Events</h1>
  <p class="text-slate-500">
    Search results for "<%= query %>".
  </p>
  <% if (session.authenticatedUser) { %>
    <p class="text-slate-500 mt-2 mb-0">
      Signed in as <strong class="text-slate-700"><%= session.authenticatedUser.displayName %></strong>
      (<%= session.authenticatedUser.role %>).
    </p>
  <% } %>
</section>

<section class="mb-5 p-6 border border-slate-200 rounded-3xl bg-gradient-to-br from-slate-50 via-white to-slate-100 shadow-xl">
  <form
    x-data="{ query: '' }"
    x-init="query = $refs.searchInput.value"
    class="relative"
  >
    <label for="search-query" class="sr-only">Search events</label>
    <input
      id="search-query"
      x-ref="searchInput"
      x-model="query"
      type="text"
      name="q"
      placeholder="Search events..."
      value="<%= query %>"
      hx-get="/events/search/results"
      hx-trigger="input"
      hx-debounce="500ms"
      hx-target="#search-results-container"
      hx-swap="outerHTML"
      hx-on="htmx:beforeRequest: document.getElementById('search-error').style.display='none'"
      class="w-full rounded-2xl border border-slate-300 bg-white px-5 py-4 pr-20 text-slate-900 text-base shadow-sm transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
    />
    <button
      type="button"
      x-show="query.length > 0"
      x-on:click.prevent="query = ''; $refs.searchInput.value = ''; $refs.searchInput.dispatchEvent(new Event('input'))"
      class="absolute inset-y-0 right-3 inline-flex items-center rounded-full bg-slate-200 px-3 text-slate-600 transition hover:bg-slate-300 focus:outline-none focus:ring-2 focus:ring-blue-500"
    >
      Clear
    </button>
  </form>
</section>

<section id="search-error" class="mb-4 p-4 rounded-xl border border-red-200 bg-red-50 text-red-800 <%= typeof error === 'undefined' || !error ? 'hidden' : '' %>" aria-live="polite">
  <h3 class="text-base font-semibold mb-1">Search Error</h3>
  <p class="mb-0 text-sm"><%= typeof error !== 'undefined' ? error : '' %></p>
</section>

<%- include('./partials/search-results-page', { data, session, query, error: typeof error !== 'undefined' ? error : undefined }) %>