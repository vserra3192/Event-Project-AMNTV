<section class="mb-5 p-6 border border-slate-200 rounded-2xl bg-gradient-to-b from-white to-slate-50 shadow-lg">
  <h1 class="text-3xl font-bold text-slate-900 mb-3">
    Edit: <%= formData.title %>
  </h1>
  <p class="text-slate-500">
    Update event details and save your changes.
  </p>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<section class="max-w-3xl p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
  <form method="POST" action="/events/<%= eventId %>/edit">
    <div class="space-y-6">

      <div>
        <h2 class="text-xl font-semibold mb-4">Event Information</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

          <div>
            <label class="text-sm font-medium text-slate-500">Category</label>
            <input
              type="text"
              name="category"
              value="<%= formData.category %>"
              class="mt-1 w-full border border-slate-300 rounded-lg p-2 text-slate-900"
              required
            />
          </div>

          <div>
            <label class="text-sm font-medium text-slate-500">Status</label>
            <select
              name="status"
              class="mt-1 w-full border border-slate-300 rounded-lg p-2 text-slate-900"
            >
              <option value="draft" <%= formData.status === "draft" ? "selected" : "" %>>Draft</option>
              <option value="published" <%= formData.status === "published" ? "selected" : "" %>>Published</option>
              <option value="cancelled" <%= formData.status === "cancelled" ? "selected" : "" %>>Cancelled</option>
              <option value="past" <%= formData.status === "past" ? "selected" : "" %>>Past</option>
            </select>
          </div>

          <div>
            <label class="text-sm font-medium text-slate-500">Location</label>
            <input
              type="text"
              name="location"
              value="<%= formData.location %>"
              class="mt-1 w-full border border-slate-300 rounded-lg p-2 text-slate-900"
              required
            />
          </div>

          <div>
            <label class="text-sm font-medium text-slate-500">Capacity</label>
            <input
              type="number"
              name="capacity"
              min="1"
              value="<%= formData.capacity %>"
              class="mt-1 w-full border border-slate-300 rounded-lg p-2 text-slate-900"
            />
          </div>

          <div>
            <label class="text-sm font-medium text-slate-500">Start Time</label>
            <input
              type="datetime-local"
              name="startDatetime"
              value="<%= formData.startDatetime %>"
              class="mt-1 w-full border border-slate-300 rounded-lg p-2 text-slate-900"
              required
            />
          </div>

          <div>
            <label class="text-sm font-medium text-slate-500">End Time</label>
            <input
              type="datetime-local"
              name="endDatetime"
              value="<%= formData.endDatetime %>"
              class="mt-1 w-full border border-slate-300 rounded-lg p-2 text-slate-900"
              required
            />
          </div>

        </div>
      </div>

      <div>
        <label class="text-sm font-medium text-slate-500">Title</label>
        <input
          type="text"
          name="title"
          value="<%= formData.title %>"
          class="mt-1 w-full border border-slate-300 rounded-lg p-2 text-slate-900"
          required
        />
      </div>

      <div>
        <label class="text-sm font-medium text-slate-500">Description</label>
        <textarea
          name="description"
          rows="4"
          class="mt-1 w-full border border-slate-300 rounded-lg p-2 text-slate-900"
          required
        ><%= formData.description %></textarea>
      </div>

      <div class="flex gap-4">
        <button
          type="submit"
          class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          Save Changes
        </button>

        <a
          href="/events/<%= eventId %>"
          class="px-6 py-2 bg-slate-200 text-slate-700 rounded-lg hover:bg-slate-300 focus:outline-none focus:ring-2 focus:ring-slate-500"
        >
          Cancel
        </a>
      </div>

    </div>
  </form>
</section>