<section class="mb-6 rounded-3xl border border-blue-300/15 bg-slate-900/60 px-7 py-6 shadow-[0_25px_60px_-35px_rgba(15,105,255,0.45)] backdrop-blur-lg">
  <h1 class="text-3xl font-semibold text-white mb-3">All Events</h1>
  <p class="text-blue-100/70">
    Browse all available events.
  </p>
  <% if (session.authenticatedUser) { %>
    <p class="text-blue-100/70 mt-2 mb-0">
      Signed in as <strong class="text-blue-100/80"><%= session.authenticatedUser.displayName %></strong>
      (<%= session.authenticatedUser.role %>).
    </p>
  <% } %>
</section>

<section class="mb-5 rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
  <form action="/events/search" method="get" class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <input
      type="text"
      name="q"
      placeholder="Search events..."
      class="flex-1 w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
    />
    <button
      type="submit"
      class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-5 py-3 text-sm font-semibold uppercase tracking-wide text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
    >
      Search
    </button>
  </form>
</section>

<%- include('./partials/events-list-page', { data, session, isArchive }) %>
