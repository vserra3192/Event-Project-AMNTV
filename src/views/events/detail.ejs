<section class="mb-6 rounded-3xl border border-blue-300/15 bg-slate-900/60 px-7 py-6 shadow-[0_25px_60px_-35px_rgba(15,105,255,0.45)] backdrop-blur-lg">
  <h1 class="text-2xl md:text-3xl font-semibold text-white mb-3"><%= event.title %></h1>
  <p class="text-blue-100/70">
    Event details and information.
  </p>
</section>

<% if (pageError) { %>
  <%- include("../partials/error", { message: pageError }) %>
<% } %>

<section class="max-w-3xl rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
  <div class="space-y-6">
    <div>
      <h2 class="text-xl font-semibold text-white mb-4">Event Information</h2>
      <dl class="grid grid-cols-1 md:grid-cols-2 gap-4" x-data="{
        relativeTime(dateStr){
          const diff = Math.round((new Date(dateStr) - Date.now()) / 86400000);
          if(diff === 0) return 'today';
          if(diff === 1) return 'tomorrow';
          if(diff === -1) return 'yesterday';
          return diff > 0 ? 'in ' + diff + ' days' : Math.abs(diff) + ' days ago';
        }
      }">
        <div>
          <dt class="text-sm font-medium text-blue-100/70">Category</dt>
          <dd class="text-white"><%= event.category %></dd>
        </div>
        <% if (event.emoji) { %>
          <div>
            <dt class="text-sm font-medium text-blue-100/70">Emoji</dt>
            <dd class="text-2xl leading-none"><%= event.emoji %></dd>
          </div>
        <% } %>
        <div>
          <dt class="text-sm font-medium text-blue-100/70">Organizer</dt>
          <dd class="text-white"><%= organizerName %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-blue-100/70">Status</dt>
          <dd class="text-white">
            <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold <%= event.status === 'published' ? 'bg-emerald-400/15 text-emerald-200' : 'bg-slate-800/70 text-blue-100/80' %>">
              <%= event.status %>
            </span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-blue-100/70">Location</dt>
          <dd class="text-white"><%= event.location %></dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-blue-100/70">Capacity</dt>
          <dd class="text-white">
            <% if (event.capacity) { %>
              <%= event.rsvpCount ?? 0 %> / <%= event.capacity %>
            <% } else { %>
              Unlimited
            <% } %>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-blue-100/70">Start Time</dt>
          <dd class="text-white">
            <%= new Date(event.startDatetime).toLocaleString() %>
            <span class="ml-2 text-xs text-blue-100/50 italic"
                  x-text="relativeTime('<%= new Date(event.startDatetime).toISOString() %>')"></span>
          </dd>
        </div>
        <div>
          <dt class="text-sm font-medium text-blue-100/70">End Time</dt>
          <dd class="text-white">
            <%= new Date(event.endDatetime).toLocaleString() %>
            <span class="ml-2 text-xs text-blue-100/50 italic"
                  x-text="relativeTime('<%= new Date(event.endDatetime).toISOString() %>')"></span>
          </dd>
        </div>
      </dl>
    </div>

    <% if (event.description) { %>
      <div>
        <h3 class="text-lg font-semibold mb-2">Description</h3>
        <p class="text-blue-100/80"><%= event.description %></p>
      </div>
    <% } %>

    <div class="flex flex-wrap gap-3">
      <a
        href="/home"
        class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-5 py-3 text-sm font-semibold uppercase tracking-wide text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Return Home
      </a>
      <% const currentUser = session?.authenticatedUser; %>
      <% const isAdmin = currentUser?.role === "admin"; %>
      <% const isOwner = currentUser?.userId === event.organizerId; %>

      <% if ((isOwner || isAdmin) && event.status !== 'cancelled') { %>
        <a
          href="/events/<%= event.id %>/edit"
          class="px-6 py-2 bg-slate-800/80 text-blue-100/80 rounded-lg hover:bg-blue-400/20 focus:outline-none focus:ring-2 focus:ring-slate-500"
        >
          Edit Event
        </a>
      <% } %>

      <% if (event.status === "draft" && (isOwner || isAdmin)) { %>
        <form method="POST" action="/events/<%= event.id %>/publish" class="inline">
          <button
            type="submit"
            class="px-6 py-2 bg-emerald-500/90 text-white shadow-lg shadow-emerald-900/40 rounded-lg hover:bg-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
            Publish Event
          </button>
        </form>
      <% } %>

      <% if (event.status === "published" && (isOwner || isAdmin)) { %>
        <form method="POST" action="/events/<%= event.id %>/cancel" class="inline">
          <button
            type="submit"
            class="px-6 py-2 bg-red-500/90 text-white shadow-lg shadow-red-950/40 rounded-lg hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-500"
          >
            Cancel Event
          </button>
        </form>
      <% } %>
    </div>

    <% if (isOwner || isAdmin) { %>
      <section class="mt-6 rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
        <div class="flex flex-col gap-4">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-xl font-semibold text-white">Attendee Management</h2>
              <p class="text-blue-100/70">Load and remove RSVP attendees for this event.</p>
            </div>
            <button
              hx-get="/events/<%= event.id %>/rsvped-users"
              hx-target="#rsvp-list"
              hx-swap="innerHTML"
              class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              Load RSVP Attendees
            </button>
          </div>

          <div id="rsvp-list" class="space-y-3 text-blue-100/70">
            <p>No attendee list loaded yet. Click the button above to view RSVPs.</p>
          </div>
        </div>
      </section>
    <% } %>

    <section class="mt-6 rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
      <h2 class="text-xl font-semibold text-white mb-4">Comments</h2>

      <form
        class="mb-6 space-y-2"
        hx-post="/events/<%= event.id %>/comments"
        hx-target="#comments"
        hx-swap="innerHTML"
        hx-on::after-request="this.reset()"
      >
        <textarea
          name="content"
          class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
          placeholder="Write a comment..."
          required
        ></textarea>

        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 cursor-pointer"
        >
          Post Comment
        </button>
      </form>

      <div
        id="comments"
        hx-get="/events/<%= event.id %>/comments"
        hx-trigger="load"
        hx-swap="innerHTML"
      ></div>
    </section>
  </div>
</section>
