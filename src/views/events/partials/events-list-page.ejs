<section id="events-list-container" class="rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
  <div class="mb-4">
    <h2 class="text-xl font-semibold text-white mb-2">Available Events</h2>
    <div class="flex gap-2 mt-4">
      <a
        href="/events"
        hx-get="/events/list?type=active"
        hx-target="#events-list-container"
        hx-swap="outerHTML"
        hx-push-url="/events"
        class="px-3 py-1 rounded text-sm border <%= !isArchive ? 'bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 border-blue-600 hover:shadow-blue-900/80' : 'bg-slate-900/70 text-blue-100/80' %>"
      >
        Active Events
      </a>

      <a
        href="/events/archive"
        hx-get="/events/list?type=archive"
        hx-target="#events-list-container"
        hx-swap="outerHTML"
        hx-push-url="/events/archive"
        class="px-3 py-1 rounded text-sm border <%= isArchive ? 'bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 border-blue-600 hover:shadow-blue-900/80' : 'bg-slate-900/70 text-blue-100/80 hover:bg-blue-400/15' %>"
      >
        Archived Events
      </a>
    </div>
    <p class="text-blue-100/70 mt-4">
      <% if (data && data.length > 0) { %>
        Displaying <%= data.length %> event<%= data.length === 1 ? '' : 's' %>.
      <% } else { %>
        No events found.
      <% } %>
    </p>
  </div>

  <% if (data && data.length > 0) { %>
    <ul class="list-none m-0 p-0 grid gap-3.5">
      <% data.forEach((event) => { %>
        <%- include('./event-item', { event, session }) %>
      <% }) %>
    </ul>
  <% } else { %>
    <p class="text-center text-blue-100/70 py-8">No events available at this time.</p>
  <% } %>
</section>