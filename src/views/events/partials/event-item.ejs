<li class="flex flex-col gap-4 rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 shadow-[0_18px_45px_-35px_rgba(59,130,246,0.75)] sm:p-5">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <% if (event.emoji) { %>
          <span class="text-2xl leading-none" aria-hidden="true"><%= event.emoji %></span>
        <% } %>
        <strong class="text-lg text-white sm:text-xl"><%= event.title %></strong>
      </div>
      <p class="mb-0 mt-1 text-sm text-blue-100/70">
        Category: <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-400/15 text-blue-100">
          <%= event.category %>
        </span>
      </p>
    </div>
    <div class="sm:text-right">
      <%- include("../../partials/status-badge", { status: event.status, eventId: event.id }) %>
    </div>
  </div>
  <div class="grid grid-cols-1 gap-3 text-sm sm:grid-cols-2">
    <div>
      <p class="text-blue-100/70 mb-0.5">Start</p>
      <p class="text-white font-medium">
        <%= new Date(event.startDatetime).toLocaleString() %>
      </p>
    </div>
    <div>
      <p class="text-blue-100/70 mb-0.5">End</p>
      <p class="text-white font-medium">
        <%= new Date(event.endDatetime).toLocaleString() %>
      </p>
    </div>
  </div>
  <div class="mt-1 flex flex-wrap gap-2">
    <a
      href="/events/<%= event.id %>"
      class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80"
    >
      View Details
    </a>
    <% if (session.authenticatedUser && session.authenticatedUser.userId === event.organizerId && event.status !== 'cancelled') { %>
      <a
        href="/events/<%= event.id %>/edit"
        class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-blue-300/20 bg-slate-800/80 px-4 py-2 text-sm font-semibold text-blue-100 transition hover:bg-blue-400/20 hover:text-white"
      >
        Edit Event
      </a>
    <% } %>
    <% if (session.authenticatedUser && event.status === 'published') { %>
      <% const hasRsvped = event.rsvps && event.rsvps.includes(session.authenticatedUser.userId); %>
      <% if (hasRsvped) { %>
        <button
          hx-post="/events/<%= event.id %>/rsvp/cancel"
          hx-target="closest li"
          hx-swap="outerHTML"
          class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-red-500/90 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-red-950/40 transition hover:bg-red-500"
        >
          Cancel RSVP
        </button>
      <% } else { %>
        <button
          hx-post="/events/<%= event.id %>/rsvp"
          hx-target="closest li"
          hx-swap="outerHTML"
          class="inline-flex cursor-pointer items-center justify-center rounded-xl bg-emerald-500/90 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-emerald-900/40 transition hover:bg-emerald-500"
        >
          RSVP
        </button>
      <% } %>
    <% } %>
  </div>
</li>
