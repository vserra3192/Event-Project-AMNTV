<section 
  id="search-results-container" 
  class="rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl"
  hx-indicator="#search-loading"
>
  <div id="search-loading" class="hidden mb-4 p-4 rounded-xl border border-blue-300/30 bg-blue-950/50 text-blue-100">
    <div class="flex items-center gap-3">
      <div class="inline-block h-4 w-4 border-2 border-blue-600 border-t-transparent rounded-full animate-spin"></div>
      <p class="mb-0 text-sm">Searching for events...</p>
    </div>
  </div>

  <div class="mb-5 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <h2 class="text-xl font-semibold text-white mb-2">Search Results</h2>
      <p class="text-blue-100/70 mb-0">
        <% if (typeof error !== 'undefined' && error) { %>
          Could not search for "<%= query %>".
        <% } else if (data && data.length > 0) { %>
          Found <%= data.length %> event<%= data.length === 1 ? '' : 's' %> matching "<%= query %>".
        <% } else { %>
          No events found matching "<%= query %>".
        <% } %>
      </p>
    </div>

    <div class="flex w-full flex-col gap-3 sm:flex-row lg:max-w-xl">
      <form
        action="/events/search"
        method="get"
        hx-get="/events/search/results"
        hx-trigger="keyup changed delay:500ms from:#search-mode-query, submit"
        hx-target="#home-events"
        hx-swap="innerHTML"
        class="flex min-w-0 flex-1 gap-3"
      >
        <input
          id="search-mode-query"
          type="text"
          name="q"
          value="<%= query %>"
          placeholder="Search events..."
          class="min-w-0 flex-1 rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-4 py-3 text-sm font-semibold uppercase tracking-wide text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          Search
        </button>
      </form>

      <button
        type="button"
        hx-get="/events/list?type=active"
        hx-target="#home-events"
        hx-swap="innerHTML"
        x-on:click="searchMode = false"
        class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-blue-300/20 bg-slate-900/70 px-3 py-2 text-sm font-semibold text-blue-100/80 transition hover:bg-blue-400/15 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Exit Search
      </button>
    </div>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 rounded-xl border border-red-400/30 bg-red-950/50 text-red-100" aria-live="polite">
      <h3 class="text-base font-semibold mb-1">Search Error</h3>
      <p class="mb-0 text-sm"><%= error %></p>
    </div>
  <% } else { %>
    <% if (data && data.length > 0) { %>
      <ul class="max-h-[34rem] list-none m-0 grid gap-3.5 overflow-y-auto p-0 pr-2">
        <% data.forEach((event) => { %>
          <%- include('./event-item', { event, session }) %>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="text-center text-blue-100/70 py-8">No events found matching your search.</p>
    <% } %>
  <% } %>
</section>
