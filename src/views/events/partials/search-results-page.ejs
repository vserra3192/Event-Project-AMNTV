<section id="search-results-container" class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="mb-4 p-4 rounded-xl border border-red-200 bg-red-50 text-red-800" aria-live="polite">
      <h3 class="text-base font-semibold mb-1">Search Error</h3>
      <p class="mb-0 text-sm"><%= error %></p>
    </div>
  <% } else { %>
    <div class="mb-4">
      <h2 class="text-xl font-semibold mb-2">Search Results</h2>
      <p class="text-slate-500">
        <% if (data && data.length > 0) { %>
          Found <%= data.length %> event<%= data.length === 1 ? '' : 's' %> matching "<%= query %>".
        <% } else { %>
          No events found matching "<%= query %>".
        <% } %>
      </p>
    </div>

    <% if (data && data.length > 0) { %>
      <ul class="list-none m-0 p-0 grid gap-3.5">
        <% data.forEach((event) => { %>
          <li class="flex flex-col gap-3 p-4 border border-slate-200 rounded-xl bg-slate-50">
            <div class="flex items-start justify-between gap-4">
              <div>
                <strong class="text-slate-900 text-lg"><%= event.title %></strong>
                <p class="text-sm text-slate-500 mt-1 mb-0">
                  Category: <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-600/12 text-blue-700">
                    <%= event.category %>
                  </span>
                </p>
              </div>
              <div class="text-right">
                <p class="text-xs font-semibold <%= event.status === 'published' ? 'text-green-700 bg-green-50' : 'text-slate-500 bg-slate-100' %> px-2.5 py-1.5 rounded-full">
                  <%= event.status %>
                </p>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3 text-sm">
              <div>
                <p class="text-slate-500 mb-0.5">Start</p>
                <p class="text-slate-900 font-medium">
                  <%= new Date(event.startDatetime).toLocaleString() %>
                </p>
              </div>
              <div>
                <p class="text-slate-500 mb-0.5">End</p>
                <p class="text-slate-900 font-medium">
                  <%= new Date(event.endDatetime).toLocaleString() %>
                </p>
              </div>
            </div>
            <div class="flex gap-2 mt-2">
              <a
                href="/events/<%= event.id %>"
                class="px-3 py-1 bg-blue-600 text-white text-sm rounded hover:bg-blue-700"
              >
                View Details
              </a>
              <% if (session.authenticatedUser && session.authenticatedUser.userId === event.organizerId) { %>
                <a
                  href="/events/<%= event.id %>/edit"
                  class="px-3 py-1 bg-slate-600 text-white text-sm rounded hover:bg-slate-700"
                >
                  Edit Event
                </a>
              <% } %>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } else { %>
      <p class="text-center text-slate-500 py-8">No events found matching your search.</p>
    <% } %>
  <% } %>
</section>