<div id="invite-panel" x-data="{ open: false }" class="space-y-4">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h2 class="text-xl font-semibold text-white">Invite Friends</h2>
      <p class="text-blue-100/70">Send event invites to people on your friends list.</p>
    </div>
    <button
      type="button"
      x-on:click="open = !open"
      class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 focus:outline-none focus:ring-2 focus:ring-blue-500"
    >
      Invite
    </button>
  </div>

  <% if (pageError) { %>
    <%- include("../../partials/error", { message: pageError }) %>
  <% } %>

  <div x-show="open" x-cloak class="space-y-3">
    <% if (!inviteFriends || inviteFriends.length === 0) { %>
      <p class="rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 text-sm text-blue-100/70">
        Your friends list is empty right now.
      </p>
    <% } else { %>
      <ul class="space-y-2">
        <% inviteFriends.forEach((friend) => { %>
          <% const alreadyInvited = invitedRecipientIds && invitedRecipientIds.includes(friend.id); %>
          <li class="flex flex-col gap-3 rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <p class="font-semibold text-white"><%= friend.displayName %></p>
              <p class="text-sm text-blue-100/60"><%= friend.email %></p>
            </div>
            <% if (alreadyInvited) { %>
              <span class="rounded-lg border border-emerald-300/30 bg-emerald-400/15 px-3 py-1 text-sm font-medium text-emerald-100">
                Invited
              </span>
            <% } else { %>
              <form
                method="POST"
                action="/events/<%= event.id %>/invites"
                hx-post="/events/<%= event.id %>/invites"
                hx-target="#invite-panel"
                hx-swap="outerHTML"
              >
                <input type="hidden" name="recipientId" value="<%= friend.id %>" />
                <button
                  type="submit"
                  class="rounded-lg border border-blue-300/30 bg-blue-400/20 px-4 py-2 text-sm font-medium text-blue-100 transition hover:bg-blue-400/30 hover:text-white"
                >
                  Send Invite
                </button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>
