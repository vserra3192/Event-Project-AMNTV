<section class="mb-6 rounded-3xl border border-blue-300/15 bg-slate-900/60 px-5 py-6 shadow-[0_25px_60px_-35px_rgba(15,105,255,0.45)] backdrop-blur-lg sm:px-7">
  <div class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-blue-200/60">Archive</p>
      <h1 class="mt-2 text-3xl font-semibold text-white sm:text-4xl">Archived Events</h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-blue-100/70 sm:text-base">
        Review concluded and cancelled events.
      </p>
    </div>
    <% if (session.authenticatedUser) { %>
      <div class="rounded-2xl border border-blue-300/15 bg-slate-950/35 px-4 py-3 text-sm text-blue-100/75">
        Signed in as <strong class="text-white"><%= session.authenticatedUser.displayName %></strong>
        (<%= session.authenticatedUser.role %>)
      </div>
    <% } %>
  </div>
</section>

<%- include('./partials/events-list-page', { data, session, isArchive }) %>
