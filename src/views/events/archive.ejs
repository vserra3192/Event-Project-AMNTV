<h1 class="text-2xl font-bold mb-4">Past Events</h1>

<% if (!data.length) { %>
  <p>No archived events yet.</p>
<% } %>

<% data.forEach(event => { %>
  <div class="border p-4 mb-2 rounded">
    <h2 class="font-semibold"><%= event.title %></h2>
    <p><%= event.category %> • ended <%= new Date(event.endDatetime).toLocaleString() %></p>
    <a href="/events/<%= event.id %>">View</a>
  </div>
<% }) %>