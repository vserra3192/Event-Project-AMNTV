<section class="mb-6 rounded-3xl border border-blue-300/15 bg-slate-900/60 px-7 py-6 shadow-[0_25px_60px_-35px_rgba(15,105,255,0.45)] backdrop-blur-lg">
  <h1 class="text-3xl font-semibold text-white mb-3">Welcome to your events!</h1>
  <p class="text-blue-100/70">
    Manage and discover events with ease.
  </p>
  <% if (session.authenticatedUser) { %>
    <p class="text-blue-100/70 mt-2 mb-0">
      Signed in as <strong class="text-blue-100/80"><%= session.authenticatedUser.displayName %></strong>
      (<%= session.authenticatedUser.email %>, role:
      <strong class="text-blue-100/80"><%= session.authenticatedUser.role %></strong>).
    </p>
  <% } %>
</section>

<% if (pageError) { %>
  <%- include("partials/error", { message: pageError }) %>
<% } %>

<section class="mb-5 rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
  <form action="/events/search" method="get" class="flex gap-3">
    <input
      type="text"
      name="q"
      placeholder="Search events..."
      class="flex-1 rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
    />
    <button
      type="submit"
      class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-5 py-3 text-sm font-semibold uppercase tracking-wide text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 focus:outline-none focus:ring-2 focus:ring-blue-500"
    >
      Search
    </button>
  </form>
</section>

<section class="max-w-3xl rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
  <div class="mb-4">
    <h2 class="text-xl font-semibold text-white mb-2">Quick Actions</h2>
    <p class="text-blue-100/70">
      Get started with managing your events.
    </p>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <a
      href="/events/new"
      class="block rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 hover:bg-slate-800/70 transition-colors text-center"
    >
      <h3 class="text-lg font-semibold text-white mb-2">Create Event</h3>
      <p class="text-blue-100/70 text-sm">Organize a new event</p>
    </a>
    <a
      href="/events"
      class="block rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 hover:bg-slate-800/70 transition-colors text-center"
    >
      <h3 class="text-lg font-semibold text-white mb-2">All Events</h3>
      <p class="text-blue-100/70 text-sm">Browse all events</p>
    </a>
    <a
      href="/dashboard"
      class="block rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 hover:bg-slate-800/70 transition-colors text-center"
    >
      <h3 class="text-lg font-semibold text-white mb-2">Organizer Dashboard</h3>
      <p class="text-blue-100/70 text-sm">Manage your events</p>
    </a>
    <a
      href="/events/rsvp"
      class="block rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 hover:bg-slate-800/70 transition-colors text-center"
    >
      <h3 class="text-lg font-semibold text-white mb-2">My RSVPs</h3>
      <p class="text-blue-100/70 text-sm">See events you have RSVP'd for</p>
    </a>
  </div>
</section>
