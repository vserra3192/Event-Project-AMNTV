<section
  class="mb-6 rounded-3xl border border-blue-300/15 bg-slate-900/60 px-7 py-6 shadow-[0_25px_60px_-35px_rgba(15,105,255,0.45)] backdrop-blur-lg"
>
  <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">
    <div>
      <h1 class="text-3xl font-semibold text-white mb-3">Welcome to Event Tracker</h1>
      <p class="text-blue-100/70">
        Find, organize, and keep up with events from one focused workspace.
      </p>
      <% if (session.authenticatedUser) { %>
        <p class="text-blue-100/70 mt-2 mb-0">
          Signed in as <strong class="text-blue-100/80"><%= session.authenticatedUser.displayName %></strong>
          (<%= session.authenticatedUser.email %>, role:
          <strong class="text-blue-100/80"><%= session.authenticatedUser.role %></strong>).
        </p>
      <% } %>
    </div>

    <a
      href="/invites"
      class="relative inline-flex items-center justify-center rounded-2xl border border-blue-300/30 bg-blue-400/20 px-5 py-3 text-sm font-semibold text-blue-100 shadow-lg shadow-blue-900/30 transition hover:bg-blue-400/30 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
    >
      <span hx-get="/inbox/indicator" hx-trigger="load, every 30s" hx-swap="innerHTML"></span>
      Inbox
    </a>
  </div>
</section>

<% if (pageError) { %>
  <%- include("partials/error", { message: pageError }) %>
<% } %>

<section
  class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]"
  x-data="{ friendsOpen: false, searchMode: false }"
>
  <div class="min-w-0 space-y-5">
    <div
      x-show="!searchMode"
      class="mb-5 flex flex-col gap-4 md:flex-row md:items-end md:justify-between"
    >
      <div>
        <h2 class="text-2xl font-semibold text-white mb-2">Find Events</h2>
        <p class="text-blue-100/70 mb-0">Browse events you can RSVP to.</p>
      </div>
      <form
        action="/events/search"
        method="get"
        hx-get="/events/search/results"
        hx-target="#home-events"
        hx-swap="innerHTML"
        x-on:submit="searchMode = true"
        class="flex w-full gap-3 md:max-w-md"
      >
        <input
          type="text"
          name="q"
          placeholder="Search events..."
          class="min-w-0 flex-1 rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
        />
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-5 py-3 text-sm font-semibold uppercase tracking-wide text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 focus:outline-none focus:ring-2 focus:ring-blue-500"
        >
          Search
        </button>
      </form>
    </div>

    <div
      id="home-events"
      hx-get="/events/list?type=active"
      hx-trigger="load"
      hx-target="#home-events"
      hx-swap="innerHTML"
    >
      <section class="rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
        <div>
          <p class="rounded-2xl border border-blue-300/10 bg-slate-950/40 px-4 py-5 text-center text-blue-100/70">
          Loading events...
          </p>
        </div>
      </section>
    </div>
  </div>

  <aside class="space-y-3 xl:sticky xl:top-8 xl:self-start">
    <a
      href="/events/new"
      class="flex min-h-28 flex-col justify-center rounded-3xl border border-blue-300/15 bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-6 py-5 text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 focus:outline-none focus:ring-2 focus:ring-blue-500"
    >
      <span class="text-xl font-semibold">Create Event</span>
      <span class="mt-2 text-sm text-blue-50/85">Draft or publish something new</span>
    </a>

    <a
      href="/dashboard"
      class="block rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 text-blue-100 transition hover:bg-slate-800/70 hover:text-white"
    >
      <span class="font-semibold">Your Events</span>
      <span class="mt-1 block text-sm text-blue-100/60">Organizer dashboard</span>
    </a>

    <a
      href="/events/rsvp"
      class="block rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 text-blue-100 transition hover:bg-slate-800/70 hover:text-white"
    >
      <span class="font-semibold">Your RSVP's</span>
      <span class="mt-1 block text-sm text-blue-100/60">Events you joined</span>
    </a>

    <button
      type="button"
      x-on:click="friendsOpen = true"
      class="w-full rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4 text-left text-blue-100 transition hover:bg-slate-800/70 hover:text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
    >
      <span class="font-semibold">Friends</span>
      <span class="mt-1 block text-sm text-blue-100/60">Manage your network</span>
    </button>
  </aside>

  <div
    x-show="friendsOpen"
    x-cloak
    class="fixed inset-0 z-40 bg-slate-950/60 backdrop-blur-sm"
    x-on:click.self="friendsOpen = false"
  >
    <aside class="ml-auto flex h-full w-full max-w-xl flex-col border-l border-blue-300/15 bg-slate-950/95 shadow-[0_25px_80px_-35px_rgba(15,105,255,0.65)]">
      <div class="flex items-center justify-between border-b border-blue-300/15 px-6 py-5">
        <div>
          <h2 class="text-xl font-semibold text-white">Friends</h2>
          <p class="text-sm text-blue-100/60">Search members and manage your list.</p>
        </div>
        <button
          type="button"
          x-on:click="friendsOpen = false"
          class="rounded-xl border border-blue-300/30 bg-blue-400/20 px-4 py-2 text-sm font-medium text-blue-100 transition hover:bg-blue-400/30 hover:text-white"
        >
          Close
        </button>
      </div>

      <div
        id="friends-panel"
        class="min-h-0 flex-1 overflow-y-auto p-6"
        hx-get="/friends/panel"
        hx-trigger="load"
        hx-target="#friends-panel"
        hx-swap="outerHTML"
      >
        <p class="rounded-2xl border border-blue-300/10 bg-slate-950/40 px-4 py-5 text-center text-blue-100/70">
          Loading friends...
        </p>
      </div>
    </aside>
  </div>
</section>
