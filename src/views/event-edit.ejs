<section class="mb-6 rounded-3xl border border-blue-300/15 bg-slate-900/60 px-7 py-6 shadow-[0_25px_60px_-35px_rgba(15,105,255,0.45)] backdrop-blur-lg">
  <h1 class="text-3xl font-semibold text-white mb-3">Edit Event</h1>
  <p class="text-blue-100/70">
    Update the details of your event.
  </p>
</section>

<section class="max-w-3xl rounded-3xl border border-blue-300/15 bg-slate-900/70 px-7 py-7 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)] backdrop-blur-xl">
  <form action="/events/<%= data.id %>" method="post" class="space-y-6">
    <input type="hidden" name="_method" value="PUT" />

    <div>
      <label for="title" class="block text-sm font-medium text-blue-100/80 mb-2">Event Title *</label>
      <input
        type="text"
        id="title"
        name="title"
        required
        value="<%= data.title %>"
        class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
        placeholder="Enter event title"
      />
    </div>

    <div>
      <label for="description" class="block text-sm font-medium text-blue-100/80 mb-2">Description</label>
      <textarea
        id="description"
        name="description"
        rows="4"
        class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
        placeholder="Describe your event"
      ><%= data.description %></textarea>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="location" class="block text-sm font-medium text-blue-100/80 mb-2">Location *</label>
        <input
          type="text"
          id="location"
          name="location"
          required
          value="<%= data.location %>"
          class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
          placeholder="Event location"
        />
      </div>

      <div>
        <label for="category" class="block text-sm font-medium text-blue-100/80 mb-2">Category *</label>
        <input
          type="text"
          id="category"
          name="category"
          required
          value="<%= data.category %>"
          class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
          placeholder="e.g., Conference, Workshop, Social"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="startDatetime" class="block text-sm font-medium text-blue-100/80 mb-2">Start Date & Time *</label>
        <input
          type="datetime-local"
          id="startDatetime"
          name="startDatetime"
          required
          value="<%= new Date(data.startDatetime).toISOString().slice(0, 16) %>"
          class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
        />
      </div>

      <div>
        <label for="endDatetime" class="block text-sm font-medium text-blue-100/80 mb-2">End Date & Time *</label>
        <input
          type="datetime-local"
          id="endDatetime"
          name="endDatetime"
          required
          value="<%= new Date(data.endDatetime).toISOString().slice(0, 16) %>"
          class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <label for="status" class="block text-sm font-medium text-blue-100/80 mb-2">Status</label>
        <select
          id="status"
          name="status"
          class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
        >
          <option value="draft" <%= data.status === 'draft' ? 'selected' : '' %>>Draft</option>
          <option value="published" <%= data.status === 'published' ? 'selected' : '' %>>Published</option>
          <option value="cancelled" <%= data.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
          <option value="past" <%= data.status === 'past' ? 'selected' : '' %>>Past</option>
        </select>
      </div>

      <div>
        <label for="capacity" class="block text-sm font-medium text-blue-100/80 mb-2">Capacity</label>
        <input
          type="number"
          id="capacity"
          name="capacity"
          min="1"
          value="<%= data.capacity || '' %>"
          class="w-full rounded-2xl border border-blue-300/20 bg-slate-950/60 px-4 py-3 text-sm text-white shadow-inner shadow-slate-900 focus:border-blue-400 focus:bg-slate-950/80 focus:outline-none focus:ring-2 focus:ring-blue-400/60"
          placeholder="Leave empty for unlimited"
        />
      </div>
    </div>

    <div class="flex gap-4">
      <button
        type="submit"
        class="inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 px-5 py-3 text-sm font-semibold uppercase tracking-wide text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Update Event
      </button>
      <a
        href="/events/<%= data.id %>"
        class="px-6 py-2 bg-slate-800/80 text-blue-100/80 rounded-lg hover:bg-blue-400/20 focus:outline-none focus:ring-2 focus:ring-slate-500"
      >
        Cancel
      </a>
    </div>
  </form>
</section>