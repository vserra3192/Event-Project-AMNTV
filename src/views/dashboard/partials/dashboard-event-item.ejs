<li class="flex flex-col gap-3 rounded-2xl border border-blue-300/10 bg-slate-950/40 p-4">
  <% if (typeof pageError !== 'undefined' && pageError) { %>
    <div class="mb-2 rounded-xl border border-red-400/30 bg-red-950/50 px-3 py-2 text-sm text-red-100">
      <%= pageError %>
    </div>
  <% } %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <strong class="text-white text-lg"><%= event.title %></strong>
      <p class="text-sm text-blue-100/70 mt-1 mb-0">
        Category: <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-400/15 text-blue-100">
          <%= event.category %>
        </span>
      </p>
    </div>
    <div class="text-right">
      <p class="text-xs font-semibold <%= event.status === 'published' ? 'text-emerald-200 bg-emerald-950/50' : 'text-blue-100/70 bg-slate-800/70' %> px-2.5 py-1.5 rounded-full">
        <%= event.status %>
      </p>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-3 text-sm">
    <div>
      <p class="text-blue-100/70 mb-0.5">Start</p>
      <p class="text-white font-medium">
        <%= new Date(event.startDatetime).toLocaleString() %>
      </p>
    </div>
    <div>
      <p class="text-blue-100/70 mb-0.5">End</p>
      <p class="text-white font-medium">
        <%= new Date(event.endDatetime).toLocaleString() %>
      </p>
    </div>
  </div>
  <% if (event.capacity !== null) { %>
    <div class="text-sm">
      <p class="text-blue-100/70 mb-0.5">RSVPs</p>
      <p class="text-white font-medium">
        <%= event.rsvps ? event.rsvps.length : 0 %> / <%= event.capacity %>
        <% if (event.capacity && event.rsvps && event.rsvps.length >= event.capacity) { %>
          <span class="font-semibold text-red-200">(Full)</span>
        <% } else if (event.capacity && event.rsvps && event.rsvps.length >= event.capacity * 0.8) { %>
          <span class="font-semibold text-amber-200">(Almost Full)</span>
        <% } %>
      </p>
    </div>
  <% } else { %>
    <div class="text-sm">
      <p class="text-blue-100/70 mb-0.5">RSVPs</p>
      <p class="text-white font-medium">
        <%= event.rsvps ? event.rsvps.length : 0 %> (No capacity limit)
      </p>
    </div>
  <% } %>
  <div class="flex gap-2 mt-2">
    <a
      href="/events/<%= event.id %>"
      class="px-3 py-1 bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 text-sm rounded hover:shadow-blue-900/80"
    >
      View Details
    </a>
    <% if (event.status !== 'cancelled') { %>
      <a
        href="/events/<%= event.id %>/edit"
        class="px-3 py-1 bg-slate-800/80 text-blue-100 border border-blue-300/20 text-sm rounded hover:bg-blue-400/20 hover:text-white"
      >
        Edit Event
      </a>
    <% } %>
    <% if (event.status === 'draft') { %>
      <button
        hx-post="/events/<%= event.id %>/publish"
        hx-target="closest li"
        hx-swap="outerHTML"
        class="px-3 py-1 bg-emerald-500/90 text-white shadow-lg shadow-emerald-900/40 text-sm rounded hover:bg-emerald-500"
      >
        Publish
      </button>
    <% } else if (event.status === 'published') { %>
      <button
        hx-post="/events/<%= event.id %>/cancel"
        hx-target="closest li"
        hx-swap="outerHTML"
        class="px-3 py-1 bg-red-500/90 text-white shadow-lg shadow-red-950/40 text-sm rounded hover:bg-red-500"
      >
        Cancel
      </button>
    <% } %>
  </div>
</li>
