<li class="flex flex-col gap-3 p-4 border border-slate-200 rounded-xl bg-slate-50">
  <% if (typeof pageError !== 'undefined' && pageError) { %>
    <div class="mb-2 px-3 py-2 text-sm text-red-700 bg-red-100 rounded">
      <%= pageError %>
    </div>
  <% } %>
  <div class="flex items-start justify-between gap-4">
    <div>
      <strong class="text-slate-900 text-lg"><%= event.title %></strong>
      <p class="text-sm text-slate-500 mt-1 mb-0">
        Category: <span class="inline-block px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-600/12 text-blue-700">
          <%= event.category %>
        </span>
      </p>
    </div>
    <div class="text-right">
      <p class="text-xs font-semibold <%= event.status === 'published' ? 'text-green-700 bg-green-50' : 'text-slate-500 bg-slate-100' %> px-2.5 py-1.5 rounded-full">
        <%= event.status %>
      </p>
    </div>
  </div>
  <div class="grid grid-cols-2 gap-3 text-sm">
    <div>
      <p class="text-slate-500 mb-0.5">Start</p>
      <p class="text-slate-900 font-medium">
        <%= new Date(event.startDatetime).toLocaleString() %>
      </p>
    </div>
    <div>
      <p class="text-slate-500 mb-0.5">End</p>
      <p class="text-slate-900 font-medium">
        <%= new Date(event.endDatetime).toLocaleString() %>
      </p>
    </div>
  </div>
  <% if (event.capacity !== null) { %>
    <div class="text-sm">
      <p class="text-slate-500 mb-0.5">RSVPs</p>
      <p class="text-slate-900 font-medium">
        <%= event.rsvps ? event.rsvps.length : 0 %> / <%= event.capacity %>
        <% if (event.capacity && event.rsvps && event.rsvps.length >= event.capacity) { %>
          <span class="text-red-600 font-semibold">(Full)</span>
        <% } else if (event.capacity && event.rsvps && event.rsvps.length >= event.capacity * 0.8) { %>
          <span class="text-orange-600 font-semibold">(Almost Full)</span>
        <% } %>
      </p>
    </div>
  <% } else { %>
    <div class="text-sm">
      <p class="text-slate-500 mb-0.5">RSVPs</p>
      <p class="text-slate-900 font-medium">
        <%= event.rsvps ? event.rsvps.length : 0 %> (No capacity limit)
      </p>
    </div>
  <% } %>
  <div class="flex gap-2 mt-2">
    <a
      href="/events/<%= event.id %>"
      class="px-3 py-1 bg-blue-600 text-white text-sm rounded hover:bg-blue-700"
    >
      View Details
    </a>
    <% if (event.status !== 'cancelled') { %>
      <a
        href="/events/<%= event.id %>/edit"
        class="px-3 py-1 bg-slate-600 text-white text-sm rounded hover:bg-slate-700"
      >
        Edit Event
      </a>
    <% } %>
    <% if (event.status === 'draft') { %>
      <button
        hx-post="/events/<%= event.id %>/publish"
        hx-target="closest li"
        hx-swap="outerHTML"
        class="px-3 py-1 bg-green-600 text-white text-sm rounded hover:bg-green-700"
      >
        Publish
      </button>
    <% } else if (event.status === 'published') { %>
      <button
        hx-post="/events/<%= event.id %>/cancel"
        hx-target="closest li"
        hx-swap="outerHTML"
        class="px-3 py-1 bg-red-600 text-white text-sm rounded hover:bg-red-700"
      >
        Cancel
      </button>
    <% } %>
  </div>
</li>