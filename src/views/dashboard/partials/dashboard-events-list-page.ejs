<section id="dashboard-events-list-container" class="rounded-3xl border <%= isArchive ? 'border-slate-300/15 bg-slate-950/60 shadow-[0_25px_70px_-40px_rgba(15,23,42,0.95)]' : 'border-blue-300/15 bg-slate-900/70 shadow-[0_25px_70px_-40px_rgba(15,105,255,0.52)]' %> px-4 py-5 backdrop-blur-xl sm:px-6 sm:py-6 lg:px-7 lg:py-7">
  <div class="mb-4">
    <h2 class="mb-2 text-xl font-semibold text-white sm:text-2xl">Your Events</h2>
    <div class="flex flex-wrap gap-2 mt-4">
      <a
        href="/dashboard"
        hx-get="/dashboard/list?type=active"
        hx-target="#dashboard-events-list-container"
        hx-swap="outerHTML"
        hx-push-url="/dashboard"
        class="inline-flex cursor-pointer items-center justify-center rounded-2xl border px-4 py-2 text-sm font-semibold <%= !isArchive ? 'border-blue-600 bg-gradient-to-br from-blue-400 via-blue-500 to-blue-600 text-white shadow-lg shadow-blue-900/60 transition duration-200 hover:-translate-y-0.5 hover:shadow-blue-900/80' : 'border-slate-300/20 bg-slate-900/70 text-slate-300 hover:bg-slate-800' %>"
      >
        Active Events
      </a>

      <a
        href="/dashboard/archive"
        hx-get="/dashboard/list?type=archive"
        hx-target="#dashboard-events-list-container"
        hx-swap="outerHTML"
        hx-push-url="/dashboard/archive"
        class="inline-flex cursor-pointer items-center justify-center rounded-2xl border px-4 py-2 text-sm font-semibold <%= isArchive ? 'border-slate-300/20 bg-slate-100 text-slate-950 shadow-sm transition' : 'border-blue-300/20 bg-slate-900/70 text-blue-100/80 hover:bg-blue-400/15' %>"
      >
        Archived Events
      </a>
    </div>
    <p class="<%= isArchive ? 'text-slate-300/75' : 'text-blue-100/70' %> mt-4">
      <% if (data && data.length > 0) { %>
        Displaying <%= data.length %> event<%= data.length === 1 ? '' : 's' %>.
      <% } else { %>
        No events found.
      <% } %>
    </p>
  </div>

  <% if (!isArchive) { %>
    <% const unpublished = data.filter(event => event.status === 'draft'); %>
    <% const published = data.filter(event => event.status === 'published'); %>

    <div class="grid gap-4">
      <section class="rounded-3xl border border-amber-300/30 bg-amber-400/10 p-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-white">Unpublished Events</h3>
            <p class="text-sm text-blue-100/70">Draft events are waiting for publishing.</p>
          </div>
          <span class="inline-flex items-center rounded-full bg-amber-400/15 px-3 py-1 text-sm font-medium text-amber-100">
            <%= unpublished.length %> <%= unpublished.length === 1 ? 'event' : 'events' %>
          </span>
        </div>

        <% if (unpublished.length > 0) { %>
          <ul class="mt-5 grid gap-3.5">
            <% unpublished.forEach((event) => { %>
              <%- include('./dashboard-event-item', { event, session }) %>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="mt-5 text-sm text-blue-100/70">No unpublished events yet.</p>
        <% } %>
      </section>

      <section class="rounded-3xl border border-emerald-300/30 bg-emerald-400/10 p-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-white">Published Events</h3>
            <p class="text-sm text-blue-100/70">Live events visible to attendees.</p>
          </div>
          <span class="inline-flex items-center rounded-full bg-emerald-400/15 px-3 py-1 text-sm font-medium text-emerald-100">
            <%= published.length %> <%= published.length === 1 ? 'event' : 'events' %>
          </span>
        </div>

        <% if (published.length > 0) { %>
          <ul class="mt-5 grid gap-3.5">
            <% published.forEach((event) => { %>
              <%- include('./dashboard-event-item', { event, session }) %>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="mt-5 text-sm text-blue-100/70">No published events yet.</p>
        <% } %>
      </section>
    </div>
  <% } else { %>
    <% const cancelled = data.filter(event => event.status === 'cancelled'); %>
    <% const past = data.filter(event => event.status === 'past'); %>

    <section
      x-data="{
        archiveFilter: 'all',
        setArchiveFilter(next) { this.archiveFilter = next; },
        clearArchiveFilter() { this.archiveFilter = 'all'; },
        hasActiveArchiveFilter() { return this.archiveFilter !== 'all'; }
      }"
      class="space-y-4"
    >
      <div class="rounded-2xl border border-slate-300/15 bg-slate-900/75 p-3 sm:p-4">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
          <div>
            <h3 class="text-sm font-semibold uppercase tracking-[0.25em] text-slate-300/65">Archive Filters</h3>
            <p class="mt-1 text-sm text-slate-300/75">Filter archived dashboard events by final status.</p>
          </div>
          <div class="flex flex-wrap items-center gap-2">
            <div class="inline-flex flex-wrap rounded-2xl border border-slate-300/15 bg-slate-950/70 p-1">
              <button
                type="button"
                x-on:click="setArchiveFilter('all')"
                :class="archiveFilter === 'all' ? 'bg-slate-100 text-slate-950 shadow-sm' : 'text-slate-300 hover:bg-slate-800/80'"
                class="inline-flex cursor-pointer items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold transition"
              >
                All
              </button>
              <button
                type="button"
                x-on:click="setArchiveFilter('past')"
                :class="archiveFilter === 'past' ? 'bg-slate-100 text-slate-950 shadow-sm' : 'text-slate-300 hover:bg-slate-800/80'"
                class="inline-flex cursor-pointer items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold transition"
              >
                Past
              </button>
              <button
                type="button"
                x-on:click="setArchiveFilter('cancelled')"
                :class="archiveFilter === 'cancelled' ? 'bg-slate-100 text-slate-950 shadow-sm' : 'text-slate-300 hover:bg-slate-800/80'"
                class="inline-flex cursor-pointer items-center justify-center rounded-xl px-4 py-2 text-sm font-semibold transition"
              >
                Cancelled
              </button>
            </div>

            <button
              type="button"
              x-cloak
              x-show="hasActiveArchiveFilter()"
              x-on:click="clearArchiveFilter()"
              class="inline-flex cursor-pointer items-center justify-center rounded-xl border border-slate-300/20 bg-slate-900/80 px-4 py-2 text-sm font-semibold text-slate-200 transition hover:bg-slate-800"
            >
              Clear Filters
            </button>
          </div>
        </div>
      </div>

      <section x-show="archiveFilter === 'all' || archiveFilter === 'cancelled'" class="rounded-3xl border border-slate-300/20 bg-slate-900/55 p-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-white">Cancelled Events</h3>
            <p class="text-sm text-slate-300/75">Events that were cancelled and archived.</p>
          </div>
          <span class="inline-flex items-center rounded-full border border-slate-300/15 bg-slate-950/75 px-4 py-2 text-sm font-semibold text-slate-200">
            <%= cancelled.length %> <%= cancelled.length === 1 ? 'event' : 'events' %>
          </span>
        </div>

        <div class="mt-5 space-y-3">
          <% if (cancelled.length > 0) { %>
            <ul class="grid gap-3.5">
              <% cancelled.forEach((event) => { %>
                <%- include('./dashboard-event-item', { event, session }) %>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="text-sm text-slate-300/75">No cancelled events are archived yet.</p>
          <% } %>
        </div>
      </section>

      <section x-show="archiveFilter === 'all' || archiveFilter === 'past'" class="rounded-3xl border border-slate-300/20 bg-slate-900/55 p-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-white">Past Events</h3>
            <p class="text-sm text-slate-300/75">Events that have already concluded.</p>
          </div>
          <span class="inline-flex items-center rounded-full border border-slate-300/15 bg-slate-950/75 px-4 py-2 text-sm font-semibold text-slate-200">
            <%= past.length %> <%= past.length === 1 ? 'event' : 'events' %>
          </span>
        </div>

        <div class="mt-5 space-y-3">
          <% if (past.length > 0) { %>
            <ul class="grid gap-3.5">
              <% past.forEach((event) => { %>
                <%- include('./dashboard-event-item', { event, session }) %>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="text-sm text-slate-300/75">No past events are archived yet.</p>
          <% } %>
        </div>
      </section>
    </section>
  <% } %>
</section>
