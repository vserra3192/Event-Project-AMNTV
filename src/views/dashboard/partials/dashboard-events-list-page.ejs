<section id="dashboard-events-list-container" class="p-6 border border-slate-200 rounded-2xl bg-white shadow-lg">
  <div class="mb-4">
    <h2 class="text-xl font-semibold mb-2">Your Events</h2>
    <div class="flex gap-2 mt-4 flex-wrap">
      <a
        href="/dashboard"
        hx-get="/dashboard/list?type=active"
        hx-target="#dashboard-events-list-container"
        hx-swap="outerHTML"
        hx-push-url="/dashboard"
        class="px-3 py-1 rounded text-sm border <%= !isArchive ? 'bg-blue-600 text-white border-blue-600 hover:bg-blue-700' : 'bg-white text-slate-700' %>"
      >
        Active Events
      </a>

      <a
        href="/dashboard/archive"
        hx-get="/dashboard/list?type=archive"
        hx-target="#dashboard-events-list-container"
        hx-swap="outerHTML"
        hx-push-url="/dashboard/archive"
        class="px-3 py-1 rounded text-sm border <%= isArchive ? 'bg-blue-600 text-white border-blue-600 hover:bg-blue-700' : 'bg-white text-slate-700 hover:bg-gray-200' %>"
      >
        Archived Events
      </a>
    </div>
    <p class="text-slate-500 mt-4">
      <% if (data && data.length > 0) { %>
        Displaying <%= data.length %> event<%= data.length === 1 ? '' : 's' %>.
      <% } else { %>
        No events found.
      <% } %>
    </p>
  </div>

  <% if (!isArchive) { %>
    <% const unpublished = data.filter(event => event.status === 'draft'); %>
    <% const published = data.filter(event => event.status === 'published'); %>

    <div class="grid gap-4">
      <section class="rounded-3xl border-2 border-yellow-400/60 bg-yellow-50 p-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Unpublished Events</h3>
            <p class="text-sm text-slate-600">Draft events are waiting for publishing.</p>
          </div>
          <span class="inline-flex items-center rounded-full bg-yellow-100 px-3 py-1 text-sm font-medium text-yellow-700">
            <%= unpublished.length %> <%= unpublished.length === 1 ? 'event' : 'events' %>
          </span>
        </div>

        <% if (unpublished.length > 0) { %>
          <ul class="mt-5 grid gap-3.5">
            <% unpublished.forEach((event) => { %>
              <%- include('./dashboard-event-item', { event, session }) %>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="mt-5 text-sm text-slate-600">No unpublished events yet.</p>
        <% } %>
      </section>

      <section class="rounded-3xl border-2 border-emerald-500/70 bg-emerald-50 p-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Published Events</h3>
            <p class="text-sm text-slate-600">Live events visible to attendees.</p>
          </div>
          <span class="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-sm font-medium text-emerald-700">
            <%= published.length %> <%= published.length === 1 ? 'event' : 'events' %>
          </span>
        </div>

        <% if (published.length > 0) { %>
          <ul class="mt-5 grid gap-3.5">
            <% published.forEach((event) => { %>
              <%- include('./dashboard-event-item', { event, session }) %>
            <% }) %>
          </ul>
        <% } else { %>
          <p class="mt-5 text-sm text-slate-600">No published events yet.</p>
        <% } %>
      </section>
    </div>
  <% } else { %>
    <% const cancelled = data.filter(event => event.status === 'cancelled'); %>
    <% const past = data.filter(event => event.status === 'past'); %>

    <section x-data="{ cancelledOpen: false, pastOpen: false }" class="space-y-4">
      <section class="rounded-3xl border-2 border-red-500/70 bg-red-50 p-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Cancelled Events</h3>
            <p class="text-sm text-slate-600">Events that were cancelled and archived.</p>
          </div>
          <button
            type="button"
            x-on:click="cancelledOpen = !cancelledOpen"
            class="inline-flex items-center gap-2 rounded-full bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500"
          >
            <span x-text="cancelledOpen ? 'Collapse' : 'Expand'"></span>
            <span x-text="cancelledOpen ? '−' : '+'"></span>
          </button>
        </div>

        <div x-show="cancelledOpen" x-cloak class="mt-5 space-y-3">
          <% if (cancelled.length > 0) { %>
            <ul class="grid gap-3.5">
              <% cancelled.forEach((event) => { %>
                <%- include('./dashboard-event-item', { event, session }) %>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="text-sm text-slate-600">No cancelled events are archived yet.</p>
          <% } %>
        </div>
      </section>

      <section class="rounded-3xl border-2 border-red-500/70 bg-red-50 p-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-semibold text-slate-900">Past Events</h3>
            <p class="text-sm text-slate-600">Events that have already concluded.</p>
          </div>
          <button
            type="button"
            x-on:click="pastOpen = !pastOpen"
            class="inline-flex items-center gap-2 rounded-full bg-red-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500"
          >
            <span x-text="pastOpen ? 'Collapse' : 'Expand'"></span>
            <span x-text="pastOpen ? '−' : '+'"></span>
          </button>
        </div>

        <div x-show="pastOpen" x-cloak class="mt-5 space-y-3">
          <% if (past.length > 0) { %>
            <ul class="grid gap-3.5">
              <% past.forEach((event) => { %>
                <%- include('./dashboard-event-item', { event, session }) %>
              <% }) %>
            </ul>
          <% } else { %>
            <p class="text-sm text-slate-600">No past events are archived yet.</p>
          <% } %>
        </div>
      </section>
    </section>
  <% } %>
</section>
